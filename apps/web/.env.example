# Google API Keys (분리 관리)
# Gemini AI 모델용 (LLM, Embeddings)
GOOGLE_API_KEY=your_google_api_key_here

# Google Drive API용 (OAuth, Drive 연동)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# (Optional) Legacy support - 둘 다 같은 키 사용 시 이것만 설정
# GOOGLE_API_KEY=your_google_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# ⚠️ Service Role Key를 Supabase Dashboard에서 복사해서 넣어주세요
# Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# CORS Settings
ALLOWED_ORIGINS=*

# LLM Model (optional - defaults to gemini-2.5-flash)
LLM_MODEL=models/gemini-2.5-flash
