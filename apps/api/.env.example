# Google Generative AI Configuration
GOOGLE_API_KEY=your-google-api-key

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# Use service_role key to bypass RLS, or anon key + SUPABASE_JWT_SECRET (folder APIs send user JWT for RLS)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Optional: anon key (if using anon key, folder APIs send user JWT so RLS auth.uid() works)
# SUPABASE_ANON_KEY=your-supabase-anon-key
# JWT Secret (Project Settings > API > JWT Secret) - required for folder/auth APIs
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# CORS Configuration
# For development/testing: use "*" to allow all origins
# For production: specify your Vercel frontend URL
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-staging.vercel.app
ALLOWED_ORIGINS=*

# Opik Configuration (optional - for RAG evaluation)
OPIK_API_KEY=your-opik-api-key
OPIK_WORKSPACE=your-opik-workspace
OPIK_PROJECT_NAME=iUM
OPIK_EVAL_MODEL=gpt-4o-mini
